{
  // Configuración para publicar en Cloudflare.
  // Sirve la carpeta sitio/ como archivos estáticos: no hay código de servidor.
  "name": "globseg-web",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./sitio",
    // Una dirección que no existe entrega sitio/404.html con código 404.
    // Con "none" devolvía un 404 con el cuerpo vacío: una pantalla en blanco
    // para quien escribió mal la dirección o llegó por un enlace viejo.
    "not_found_handling": "404-page"
  }
}
